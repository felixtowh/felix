<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{{ app.name }} - Dify Portal</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤖</text></svg>">
    <!-- Marked.js for Markdown rendering -->
    <script src="https://cdn.jsdelivr.net/npm/marked@9.1.6/marked.min.js"></script>
    <!-- Highlight.js for code syntax highlighting -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/github-dark.min.css" media="(prefers-color-scheme: dark)">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/github.min.css" media="(prefers-color-scheme: light)">
    <script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/highlight.min.js"></script>
    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --primary-light: #818cf8;
            --secondary: #8b5cf6;
            --accent: #06b6d4;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --background: #f8fafc;
            --surface: #ffffff;
            --surface-hover: #f1f5f9;
            --sidebar-bg: #f8fafc;
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --border: #e2e8f0;
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
            --radius-sm: 6px;
            --radius: 12px;
            --radius-lg: 16px;
            --message-user-bg: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            --message-assistant-bg: var(--surface);
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --background: #0f172a;
                --surface: #1e293b;
                --surface-hover: #334155;
                --sidebar-bg: #1e293b;
                --text-primary: #f1f5f9;
                --text-secondary: #94a3b8;
                --text-muted: #64748b;
                --border: #334155;
                --message-assistant-bg: #334155;
            }
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans SC', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: var(--background);
            height: 100vh;
            color: var(--text-primary);
            overflow: hidden;
        }

        /* Portal Layout */
        .portal-layout {
            display: flex;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
        }

        .portal-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .portal-sidebar {
            width: 200px;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            display: flex;
            flex-direction: column;
            padding: 16px 0 12px;
            gap: 4px;
            flex-shrink: 0;
            border-right: 1px solid rgba(255,255,255,0.06);
            transition: width 0.25s ease;
            position: relative;
        }

        .portal-sidebar.collapsed {
            width: 64px;
        }

        .portal-sidebar.collapsed .portal-app-name,
        .portal-sidebar.collapsed .portal-apps-label,
        .portal-sidebar.collapsed .portal-user-name,
        .portal-sidebar.collapsed .portal-collapse-text {
            display: none;
        }

        .portal-sidebar.collapsed .portal-app-item {
            justify-content: center;
            padding: 0;
        }

        .portal-sidebar.collapsed .portal-app-icon {
            margin-right: 0;
        }

        .portal-logo {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin: 0 auto 8px;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
            cursor: pointer;
        }

        .portal-apps-label {
            font-size: 10px;
            color: rgba(255,255,255,0.3);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 4px 12px 6px;
            font-weight: 600;
        }

        .portal-apps-list {
            display: flex;
            flex-direction: column;
            gap: 2px;
            flex: 1;
            overflow-y: auto;
            width: 100%;
            padding: 0 8px;
        }

        .portal-apps-list::-webkit-scrollbar { width: 0; }

        .portal-app-item {
            display: flex;
            align-items: center;
            padding: 8px 10px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            color: rgba(255,255,255,0.55);
            position: relative;
            flex-shrink: 0;
            gap: 10px;
        }

        .portal-app-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
        }

        .portal-app-name {
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .portal-app-item:hover {
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.9);
        }

        .portal-app-item.active {
            background: rgba(255,255,255,0.1);
            color: #fff;
        }

        .portal-app-item.active::before {
            content: '';
            position: absolute;
            left: -8px;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 18px;
            background: linear-gradient(180deg, var(--primary-light) 0%, var(--accent) 100%);
            border-radius: 0 3px 3px 0;
        }

        .portal-user {
            margin-top: auto;
            padding: 10px 8px 0;
            border-top: 1px solid rgba(255,255,255,0.06);
            display: flex;
            flex-direction: column;
            gap: 6px;
            width: 100%;
        }

        .portal-user-menu {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
            color: rgba(255,255,255,0.55);
            position: relative;
        }

        .portal-user-menu:hover {
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.9);
        }

        .portal-user-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 11px;
            font-weight: 600;
            flex-shrink: 0;
        }

        .portal-user-name {
            font-size: 12px;
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .portal-user-dropdown {
            position: absolute;
            bottom: calc(100% + 8px);
            left: 8px;
            right: 8px;
            background: #1e293b;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            padding: 6px;
            display: none;
            flex-direction: column;
            gap: 2px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
            z-index: 1000;
        }

        .portal-user-dropdown.show {
            display: flex;
        }

        .portal-user-dropdown-item {
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 12px;
            color: rgba(255,255,255,0.7);
            cursor: pointer;
            transition: all 0.15s;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .portal-user-dropdown-item:hover {
            background: rgba(255,255,255,0.08);
            color: #fff;
        }

        .portal-user-dropdown-item.danger {
            color: var(--danger);
        }

        .portal-user-dropdown-item.danger:hover {
            background: rgba(239, 68, 68, 0.15);
        }

        .portal-collapse-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 6px;
            margin: 0 8px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            color: rgba(255,255,255,0.3);
            font-size: 11px;
            border: none;
            background: transparent;
        }

        .portal-collapse-btn:hover {
            color: rgba(255,255,255,0.7);
            background: rgba(255,255,255,0.05);
        }

        /* Header */
        .header {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 0 20px;
            flex-shrink: 0;
            backdrop-filter: blur(12px);
        }

        .header-content {
            height: 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .sidebar-toggle {
            display: none;
            width: 40px;
            height: 40px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            background: var(--surface);
            cursor: pointer;
            font-size: 18px;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            transition: all 0.2s;
        }

        .sidebar-toggle:hover {
            background: var(--surface-hover);
            color: var(--primary);
        }

        .back-btn {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 12px;
            border-radius: var(--radius-sm);
            transition: all 0.2s;
        }

        .back-btn:hover {
            background: var(--surface-hover);
            color: var(--primary);
        }

        .app-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .app-selector {
            position: relative;
        }

        .app-selector select {
            padding: 8px 32px 8px 12px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 14px;
            background: var(--surface);
            color: var(--text-primary);
            cursor: pointer;
            appearance: none;
            min-width: 140px;
            font-weight: 500;
        }

        .app-selector::after {
            content: '▼';
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 10px;
            color: var(--text-muted);
            pointer-events: none;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            background: var(--surface-hover);
            border-radius: var(--radius);
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
        }

        .user-avatar {
            width: 24px;
            height: 24px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 10px;
            font-weight: 600;
        }

        /* Main Layout */
        .main-container {
            flex: 1;
            display: flex;
            overflow: hidden;
        }

        /* Sidebar */
        .sidebar {
            width: 280px;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            transition: transform 0.3s ease;
        }

        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .sidebar-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .new-chat-btn {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .new-chat-btn:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
        }

        .conversation-list {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
        }

        .conversation-item {
            padding: 14px;
            border-radius: var(--radius);
            cursor: pointer;
            margin-bottom: 6px;
            transition: all 0.2s;
            border: 1px solid transparent;
        }

        .conversation-item:hover {
            background: var(--surface);
            border-color: var(--border);
        }

        .conversation-item.active {
            background: rgba(99, 102, 241, 0.1);
            border-color: var(--primary-light);
        }

        .conversation-item .conv-title {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 4px;
        }

        .conversation-item .conv-time {
            font-size: 12px;
            color: var(--text-muted);
        }

        .empty-conversations {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
            font-size: 13px;
        }

        .sidebar-footer {
            padding: 16px 20px;
            border-top: 1px solid var(--border);
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
        }

        /* Chat Area */
        .chat-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--background);
        }

        .chat-container {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Welcome Message */
        .welcome-message {
            text-align: center;
            color: var(--text-muted);
            padding: 60px 20px;
            max-width: 600px;
            margin: 0 auto;
        }

        .welcome-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            margin: 0 auto 24px;
            box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
        }

        .welcome-message h3 {
            font-size: 24px;
            margin-bottom: 12px;
            color: var(--text-primary);
            font-weight: 700;
        }

        .welcome-message p {
            font-size: 16px;
            line-height: 1.6;
        }

        .app-description {
            font-size: 14px;
            color: var(--text-secondary);
            margin-top: 12px;
            padding: 12px 16px;
            background: var(--surface-hover);
            border-radius: var(--radius);
            line-height: 1.6;
            max-width: 480px;
            margin-left: auto;
            margin-right: auto;
            text-align: left;
        }

        /* Messages *
        .message {
            max-width: 85%;
            padding: 16px 20px;
            border-radius: var(--radius-lg);
            font-size: 15px;
            line-height: 1.7;
            word-wrap: break-word;
            position: relative;
            animation: messageSlide 0.3s ease;
        }

        @keyframes messageSlide {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .message-user {
            align-self: flex-end;
            background: var(--message-user-bg);
            color: #fff;
            border-bottom-right-radius: var(--radius-sm);
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
        }

        .message-assistant {
            align-self: flex-start;
            background: var(--message-assistant-bg);
            color: var(--text-primary);
            border: 1px solid var(--border);
            border-bottom-left-radius: var(--radius-sm);
            box-shadow: var(--shadow);
        }

        .message-time {
            font-size: 11px;
            opacity: 0.7;
            margin-top: 8px;
        }

        .message-actions {
            display: flex;
            gap: 8px;
            margin-top: 12px;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .message-assistant:hover .message-actions {
            opacity: 1;
        }

        .message-action-btn {
            background: var(--surface-hover);
            border: none;
            cursor: pointer;
            font-size: 14px;
            padding: 6px 10px;
            border-radius: var(--radius-sm);
            color: var(--text-muted);
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .message-action-btn:hover {
            background: var(--border);
            color: var(--text-primary);
        }

        .message-action-btn.active-like {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success);
        }

        .message-action-btn.active-dislike {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
        }

        .message-files {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 12px;
        }

        .message-file {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            background: rgba(0,0,0,0.05);
            border-radius: var(--radius-sm);
            font-size: 13px;
        }

        .message-file img {
            max-width: 200px;
            max-height: 150px;
            border-radius: var(--radius-sm);
            box-shadow: var(--shadow-sm);
        }

        /* Input Area */
        .input-container {
            background: var(--surface);
            border-top: 1px solid var(--border);
            padding: 20px 24px;
            flex-shrink: 0;
        }

        .input-wrapper {
            max-width: 900px;
            margin: 0 auto;
            display: flex;
            gap: 12px;
            align-items: flex-end;
        }

        .input-left {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .input-btn {
            width: 44px;
            height: 44px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--surface);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--text-muted);
            transition: all 0.2s;
        }

        .input-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
            background: rgba(99, 102, 241, 0.05);
        }

        .input-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .input-btn.recording {
            background: var(--danger);
            border-color: var(--danger);
            color: white;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .input-main {
            flex: 1;
            position: relative;
            background: var(--background);
            border: 2px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 4px 8px;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .input-main.drag-over {
            border-color: var(--primary);
            background: rgba(99, 102, 241, 0.05);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

        .input-options {
            max-width: 900px;
            margin: 8px auto 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .mode-selector {
            display: flex;
            gap: 8px;
            padding: 0;
            border-bottom: none;
        }

        .mode-selector select {
            padding: 4px 10px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            background: var(--surface);
            color: var(--text-secondary);
            font-size: 13px;
            cursor: pointer;
            outline: none;
            transition: all 0.2s;
        }

        .mode-selector select:hover {
            border-color: var(--primary-light);
            color: var(--primary);
        }

        .mode-selector select:focus {
            border-color: var(--primary);
        }

        .input-main:focus-within {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

        .file-preview {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 8px;
            padding: 8px;
            display: none;
        }

        .file-preview.active {
            display: flex;
        }

        .file-preview-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            background: var(--surface);
            border-radius: var(--radius-sm);
            font-size: 13px;
            border: 1px solid var(--border);
        }

        .file-preview-item .remove-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 16px;
            padding: 0;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: all 0.2s;
        }

        .file-preview-item .remove-btn:hover {
            background: var(--danger);
            color: white;
        }

        .file-preview-item img {
            max-width: 50px;
            max-height: 50px;
            border-radius: var(--radius-sm);
        }

        .message-input-wrapper {
            display: flex;
            align-items: flex-end;
            gap: 8px;
        }

        .message-input {
            flex: 1;
            border: none;
            background: transparent;
            padding: 8px 10px;
            font-size: 15px;
            resize: none;
            min-height: 24px;
            max-height: 150px;
            font-family: inherit;
            color: var(--text-primary);
        }

        .message-input:focus {
            outline: none;
        }

        .message-input::placeholder {
            color: var(--text-muted);
        }

        .input-actions {
            display: flex;
            gap: 8px;
            padding-right: 4px;
            padding-bottom: 4px;
        }

        .send-btn, .stop-btn {
            padding: 10px 20px;
            border: none;
            border-radius: var(--radius);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .send-btn {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: #fff;
        }

        .send-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
        }

        .send-btn:disabled {
            background: var(--text-muted);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .stop-btn {
            background: var(--danger);
            color: #fff;
        }

        .stop-btn:hover {
            background: #dc2626;
            transform: translateY(-1px);
        }

        /* Typing Indicator */
        .typing-indicator {
            display: flex;
            gap: 6px;
            padding: 16px 20px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            align-self: flex-start;
            border-bottom-left-radius: var(--radius-sm);
            box-shadow: var(--shadow);
        }

        .typing-dot {
            width: 8px;
            height: 8px;
            background: var(--primary);
            border-radius: 50%;
            animation: typing 1.4s infinite;
        }

        .typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .typing-dot:nth-child(3) { animation-delay: 0.4s; }

        @keyframes typing {
            0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
            30% { transform: translateY(-10px); opacity: 1; }
        }

        /* Streaming Cursor */
        .streaming-cursor {
            display: inline-block;
            width: 2px;
            height: 1.2em;
            background: var(--primary);
            margin-left: 4px;
            animation: blink 1s infinite;
            vertical-align: middle;
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        /* Toast */
        .toast {
            position: fixed;
            bottom: 100px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--text-primary);
            color: white;
            padding: 12px 24px;
            border-radius: var(--radius);
            font-size: 14px;
            font-weight: 500;
            z-index: 1000;
            opacity: 0;
            transition: all 0.3s;
            pointer-events: none;
            box-shadow: var(--shadow-lg);
        }

        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(-10px);
        }

        /* Modal Styles */
        .modal {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            backdrop-filter: blur(4px);
        }

        .modal.active { display: flex; }

        .modal-content {
            background: var(--surface);
            border-radius: var(--radius-lg);
            width: 90%;
            max-width: 480px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--shadow-xl);
            animation: modalSlideIn 0.2s ease;
        }

        @keyframes modalSlideIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .modal-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h3 {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .modal-close {
            width: 32px;
            height: 32px;
            border-radius: var(--radius-sm);
            border: none;
            background: var(--surface-hover);
            color: var(--text-secondary);
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-close:hover {
            background: var(--border);
            color: var(--text-primary);
        }

        .modal-body {
            padding: 24px;
        }

        .modal-footer {
            padding: 16px 24px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }

        .form-group input {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 14px;
            background: var(--background);
            color: var(--text-primary);
        }

        .form-group input:focus {
            outline: none;
            border-color: var(--primary);
        }

        .btn {
            padding: 10px 20px;
            border-radius: var(--radius-sm);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
        }

        .btn-primary:hover { opacity: 0.9; }

        .btn-secondary {
            background: var(--surface-hover);
            color: var(--text-secondary);
            border: 1px solid var(--border);
        }

        .btn-secondary:hover { background: var(--border); }

        /* Markdown Styles */
        .markdown-body { font-size: 15px; line-height: 1.7; }
        .markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4 {
            margin-top: 20px;
            margin-bottom: 12px;
            font-weight: 700;
            color: var(--text-primary);
        }
        .markdown-body p { margin-bottom: 12px; }
        .markdown-body pre {
            background: #1e293b;
            border-radius: var(--radius);
            padding: 16px;
            overflow-x: auto;
            position: relative;
            margin: 12px 0;
        }
        .markdown-body code {
            font-family: 'SF Mono', Monaco, Consolas, 'Liberation Mono', monospace;
            font-size: 14px;
        }
        .markdown-body pre code {
            display: block;
            color: #e2e8f0;
        }
        .markdown-body :not(pre) code {
            background: rgba(99, 102, 241, 0.1);
            color: var(--primary);
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 13px;
        }
        .markdown-body blockquote {
            border-left: 4px solid var(--primary);
            padding-left: 16px;
            color: var(--text-secondary);
            margin: 12px 0;
            font-style: italic;
        }
        .markdown-body ul, .markdown-body ol {
            padding-left: 24px;
            margin: 12px 0;
        }
        .markdown-body li {
            margin-bottom: 6px;
        }
        .markdown-body table {
            border-collapse: collapse;
            width: 100%;
            margin: 12px 0;
            border-radius: var(--radius-sm);
            overflow: hidden;
        }
        .markdown-body th, .markdown-body td {
            border: 1px solid var(--border);
            padding: 10px 14px;
            text-align: left;
        }
        .markdown-body th {
            background: var(--surface-hover);
            font-weight: 600;
        }
        .markdown-body tr:nth-child(even) {
            background: var(--surface-hover);
        }
        .copy-code-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: var(--radius-sm);
            padding: 6px 12px;
            font-size: 12px;
            color: #94a3b8;
            cursor: pointer;
            opacity: 0;
            transition: all 0.2s;
        }
        .markdown-body pre:hover .copy-code-btn {
            opacity: 1;
        }
        .copy-code-btn:hover {
            background: rgba(255,255,255,0.2);
            color: white;
        }

        .markdown-body img {
            max-width: 100%;
            max-height: 400px;
            border-radius: var(--radius-sm);
            display: block;
            margin: 8px 0;
        }

        /* Sidebar Overlay */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 99;
            backdrop-filter: blur(4px);
        }

        .sidebar-overlay.show {
            display: block;
        }

        /* Mobile Responsive */
        @media (max-width: 768px) {
            .portal-sidebar {
                display: none;
            }

            .sidebar-toggle {
                display: flex;
            }

            .sidebar {
                position: fixed;
                left: 0;
                top: 0;
                bottom: 0;
                z-index: 100;
                transform: translateX(-100%);
                width: 280px;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .chat-container {
                padding: 16px;
            }

            .message {
                max-width: 92%;
                font-size: 15px;
                padding: 14px 16px;
            }

            .message-actions {
                opacity: 1;
            }

            .input-container {
                padding: 12px 16px;
            }

            .input-btn {
                width: 40px;
                height: 40px;
            }

            .send-btn, .stop-btn {
                padding: 8px 16px;
                min-width: 44px;
                min-height: 44px;
            }

            .message-input {
                font-size: 16px;
            }

            .header-left {
                gap: 12px;
            }

            .back-btn span {
                display: none;
            }

            .user-info span:last-child {
                display: none;
            }
        }

        /* 反馈弹窗 */
        .feedback-modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            backdrop-filter: blur(4px);
        }
        .feedback-modal-overlay.show { display: flex; }
        .feedback-modal {
            background: var(--surface);
            border-radius: var(--radius-lg);
            padding: 24px;
            width: 90%;
            max-width: 420px;
            box-shadow: var(--shadow-lg);
            animation: modalSlide 0.2s ease;
        }
        @keyframes modalSlide {
            from { opacity: 0; transform: translateY(20px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .feedback-modal h3 {
            font-size: 18px;
            margin-bottom: 8px;
            color: var(--text-primary);
        }
        .feedback-modal p {
            font-size: 14px;
            color: var(--text-secondary);
            margin-bottom: 16px;
        }
        .feedback-modal textarea {
            width: 100%;
            min-height: 100px;
            padding: 12px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--background);
            color: var(--text-primary);
            font-size: 14px;
            resize: vertical;
            margin-bottom: 16px;
            font-family: inherit;
        }
        .feedback-modal textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
        }
        .feedback-modal-buttons {
            display: flex;
            gap: 12px;
            justify-content: flex-end;
        }
        .feedback-modal-btn {
            padding: 10px 20px;
            border-radius: var(--radius-sm);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
        }
        .feedback-modal-btn.cancel {
            background: var(--surface-hover);
            color: var(--text-secondary);
        }
        .feedback-modal-btn.cancel:hover { background: var(--border); }
        .feedback-modal-btn.submit {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
        }
        .feedback-modal-btn.submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(99,102,241,0.4);
        }

        /* ===== 建议问题按钮 ===== */
        .suggested-btn {
            background: var(--surface-hover);
            color: var(--text-secondary);
            border: 1px solid var(--border);
            border-radius: var(--radius-xl);
            padding: 6px 14px;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .suggested-btn:hover {
            background: var(--primary-bg);
            color: var(--primary);
            border-color: var(--primary-light);
        }

        /* ===== 动态表单 ===== */
        .dynamic-inputs {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }
        .dynamic-inputs select,
        .dynamic-inputs input,
        .dynamic-inputs textarea {
            background: var(--surface-hover);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 4px 10px;
            font-size: 13px;
            color: var(--text-primary);
            font-family: inherit;
        }
        .dynamic-inputs select:focus,
        .dynamic-inputs input:focus,
        .dynamic-inputs textarea:focus {
            outline: none;
            border-color: var(--primary-light);
            background: var(--surface);
        }

        /* ===== 文件上传提示 ===== */
        .upload-hint {
            opacity: 0.8;
        }

        /* ===== 禁用拖拽 ===== */
        .upload-disabled {
            cursor: default !important;
        }

        /* ===== 思考过程折叠面板 ===== */
        .thinking-area {
            margin-top: 12px;
            padding-top: 8px;
            border-top: 1px dashed var(--border);
        }
        .thinking-panel {
            background: var(--surface-hover);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 8px 12px;
        }
        .thinking-panel summary {
            font-size: 13px;
            color: var(--text-muted);
            cursor: pointer;
            user-select: none;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .thinking-panel summary:hover {
            color: var(--text-secondary);
        }
        .thinking-panel[open] summary {
            margin-bottom: 8px;
        }
        .thinking-body {
            font-size: 13px;
            color: var(--text-secondary);
            line-height: 1.6;
            padding-left: 8px;
            border-left: 2px solid var(--border);
        }
        .thinking-body p {
            margin: 4px 0;
        }
        .thinking-body pre {
            background: var(--surface);
            padding: 8px;
            border-radius: var(--radius-sm);
            overflow-x: auto;
        }
    </style>
</head>
<body>
    <div class="portal-layout">
        <!-- Portal 侧边栏 -->
        <aside class="portal-sidebar" id="portalSidebar">
            <div class="portal-logo" title="Dify Portal" onclick="togglePortalSidebar()">🤖</div>
            <div class="portal-apps-label">应用</div>
            <div class="portal-apps-list" id="portalAppsList"></div>
            <div class="portal-user">
                <button class="portal-collapse-btn" onclick="togglePortalSidebar()" title="收起/展开">
                    <span id="collapseIcon">◀</span>
                </button>
                <div class="portal-user-menu" onclick="toggleUserDropdown(event)" id="portalUserMenu">
                    <div class="portal-user-avatar">{{ user.name[0] }}</div>
                    <span class="portal-user-name">{{ user.name }}</span>
                    <div class="portal-user-dropdown" id="portalUserDropdown">
                        <a class="portal-user-dropdown-item" href="javascript:void(0)" onclick="showChangePasswordModal()">🔒 修改密码</a>
                        {% if user.is_admin %}
                        <a class="portal-user-dropdown-item" href="/admin" target="_blank">⚙️ 管理后台</a>
                        {% endif %}
                        <div class="portal-user-dropdown-item danger" onclick="logout()">🚪 退出登录</div>
                    </div>
                </div>
            </div>
        </aside>

        <div class="portal-main">
            <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

            <header class="header">
                <div class="header-content">
                    <div class="header-left">
                        <button class="sidebar-toggle" onclick="toggleSidebar()">☰</button>
                        <span class="app-title" id="appTitle">{{ app.name }}</span>
                    </div>
                </div>
            </header>

            <div class="main-container">
                <aside class="sidebar" id="sidebar">
                    <div class="sidebar-header">
                        <span class="sidebar-title">历史对话</span>
                        <button class="new-chat-btn" onclick="startNewChat()">
                            <span>+</span>
                            <span>新建</span>
                        </button>
                    </div>
                    <div class="conversation-list" id="conversationList">
                        <div class="empty-conversations">加载中...</div>
                    </div>
                    <div class="sidebar-footer">
                        Dify Portal 🤖
                    </div>
                </aside>

                <main class="chat-wrapper">
                    <div class="chat-container" id="chatContainer">
                        <div class="welcome-message" id="welcomeMessage">
                            <div class="welcome-icon">
                                {% if app.logo_url %}
                                <img src="{{ app.logo_url }}" alt="{{ app.name }}" style="width:100%;height:100%;object-fit:cover;border-radius:var(--radius-lg);">
                                {% else %}
                                🤖
                                {% endif %}
                            </div>
                            <h3>{{ app.welcome_message or '你好！有什么可以帮助你的吗？' }}</h3>
                            <p>开始对话吧</p>
                            {% if app.description %}
                            <div class="app-description" id="appDescription">{{ app.description }}</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="input-container">
                        <div class="input-wrapper">
                            <div class="input-left">
                                <button class="input-btn" id="uploadBtn" onclick="document.getElementById('fileInput').click()" title="上传文件">📎</button>
                                <input type="file" id="fileInput" style="display: none;" onchange="handleFileSelect(event)">
                                <button class="input-btn" id="voiceBtn" onclick="toggleVoiceInput()" title="语音输入">🎤</button>
                            </div>
                            <div class="input-main" id="dropZone">
                                <div class="file-preview" id="filePreview"></div>
                                <div class="message-input-wrapper">
                                    <textarea class="message-input" id="messageInput" placeholder="输入消息..." rows="1"></textarea>
                                    <div class="input-actions">
                                        <button class="send-btn" id="sendBtn" onclick="sendMessage()">
                                            <span>🚰</span>
                                            <span>发送</span>
                                        </button>
                                        <button class="stop-btn" id="stopBtn" onclick="stopGeneration()" style="display: none;">
                                            <span>■</span>
                                            <span>停止</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="input-options">
                            <div class="mode-selector">
                                <select id="modeSelector" title="回答方式">
                                    <option value="快速回复">⚡ 快速回复</option>
                                    <option value="深度思考">🛠️ 深度思考</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </main>
            </div>

            <div class="toast" id="toast"></div>
        </div>
    </div>

    <script>
        // Original JavaScript from the template - keeping it functional
        let appId = {{ app.id }};
        let apiKey = "{{ app.api_key }}";
        let baseUrl = "{{ app.base_url or 'http://dify.towh.cn' }}";
        let userField = "{{ app.user_field or 'name' }}";
        const userId = "{{ user.userid or user.name }}";
        let currentConversationId = null;
        let conversations = [];
        let userApps = [];
        let currentStreamingMessage = null;
        let abortController = null;
        let pendingFiles = [];
        let isRecording = false;
        let mediaRecorder = null;
        let audioChunks = [];
        let appFeatures = null;  // Dify 应用能力配置缓存
        let currentApp = {
            id: appId,
            name: "{{ app.name }}",
            welcome_message: "{{ app.welcome_message or '你好！有什么可以帮助你的吗？' }}",
            description: "{{ app.description or '' }}",
            logo_url: "{{ app.logo_url or '' }}"
        };

        const THINKING_DISPLAY_MODE = 'fold';  // 'fold' | 'hidden' | 'show'

        const chatContainer = document.getElementById('chatContainer');
        const messageInput = document.getElementById('messageInput');
        const sendBtn = document.getElementById('sendBtn');
        const stopBtn = document.getElementById('stopBtn');
        const conversationList = document.getElementById('conversationList');
        const appSelector = document.getElementById('appSelector');
        let welcomeMessage = document.getElementById('welcomeMessage');
        const filePreview = document.getElementById('filePreview');
        const voiceBtn = document.getElementById('voiceBtn');
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        const uploadBtn = document.getElementById('uploadBtn');
        const fileInput = document.getElementById('fileInput');
        const dropZone = document.getElementById('dropZone');

        document.addEventListener('DOMContentLoaded', async function() {
            // 第一步：先拉取 Dify 应用配置
            await loadAppParameters();
            // 第二步：再加载会话列表等
            loadUserApps();
            loadConversations();
            setupDragDrop();
            refreshUserInfo();

            // 浏览器后退/前进按钮支持
            window.addEventListener('popstate', async function(event) {
                const match = window.location.pathname.match(/\/chat\/(\d+)/);
                if (match) {
                    const newAppId = parseInt(match[1]);
                    if (newAppId !== appId) {
                        await switchApp(newAppId);
                    }
                }
            });
        });

        async function refreshUserInfo() {
            try {
                const res = await fetch('/api/user/me');
                if (res.ok) {
                    const data = await res.json();
                    if (data.success && data.user) {
                        const isAdmin = data.user.is_admin;
                        const dropdown = document.getElementById('portalUserDropdown');
                        if (!dropdown) return;
                        const existingAdminLink = dropdown.querySelector('a[href="/admin"]');
                        if (isAdmin && !existingAdminLink) {
                            const link = document.createElement('a');
                            link.className = 'portal-user-dropdown-item';
                            link.href = '/admin';
                            link.target = '_blank';
                            link.textContent = '⚙️ 管理后台';
                            dropdown.insertBefore(link, dropdown.lastElementChild);
                        } else if (!isAdmin && existingAdminLink) {
                            existingAdminLink.remove();
                        }
                    }
                }
            } catch (e) { console.error('刷新用户信息失败:', e); }
        }

        function toggleSidebar() {
            sidebar.classList.toggle('open');
            sidebarOverlay.classList.toggle('show');
        }

        function togglePortalSidebar() {
            const sidebar = document.getElementById('portalSidebar');
            const icon = document.getElementById('collapseIcon');
            sidebar.classList.toggle('collapsed');
            icon.textContent = sidebar.classList.contains('collapsed') ? '▶' : '◀';
            localStorage.setItem('portalSidebarCollapsed', sidebar.classList.contains('collapsed'));
        }

        // 恢复侧边栏折叠状态
        (function() {
            const collapsed = localStorage.getItem('portalSidebarCollapsed') === 'true';
            if (collapsed) {
                const sidebar = document.getElementById('portalSidebar');
                const icon = document.getElementById('collapseIcon');
                if (sidebar) sidebar.classList.add('collapsed');
                if (icon) icon.textContent = '▶';
            }
        })();

        function toggleUserDropdown(event) {
            if (event) event.stopPropagation();
            const dropdown = document.getElementById('portalUserDropdown');
            dropdown.classList.toggle('show');
        }

        // 点击外部关闭下拉菜单
        document.addEventListener('click', function(event) {
            const menu = document.getElementById('portalUserMenu');
            const dropdown = document.getElementById('portalUserDropdown');
            if (menu && dropdown && !menu.contains(event.target)) {
                dropdown.classList.remove('show');
            }
        });

        async function logout() {
            try {
                const response = await fetch('/logout');
                if (response.ok || response.redirected) {
                    window.location.href = '/login';
                }
            } catch (error) {
                window.location.href = '/login';
            }
        }

        function showChangePasswordModal() {
            document.getElementById('portalUserDropdown').classList.remove('show');
            document.getElementById('passwordModal').classList.add('active');
        }

        function hidePasswordModal() {
            document.getElementById('passwordModal').classList.remove('active');
            document.getElementById('oldPassword').value = '';
            document.getElementById('newPassword').value = '';
            document.getElementById('confirmPassword').value = '';
        }

        async function submitChangePassword() {
            const oldPwd = document.getElementById('oldPassword').value;
            const newPwd = document.getElementById('newPassword').value;
            const confirmPwd = document.getElementById('confirmPassword').value;

            if (!oldPwd || !newPwd || !confirmPwd) {
                showToast('请填写所有密码字段');
                return;
            }
            if (newPwd !== confirmPwd) {
                showToast('两次输入的新密码不一致');
                return;
            }

            try {
                const response = await fetch('/api/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ current_password: oldPwd, new_password: newPwd })
                });
                const data = await response.json();
                if (data.success) {
                    showToast('✅ 密码修改成功');
                    hidePasswordModal();
                } else {
                    showToast('❌ ' + (data.message || data.detail || '密码修改失败'));
                }
            } catch (error) {
                showToast('❌ 密码修改失败');
            }
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.classList.add('show');
            setTimeout(() => { toast.classList.remove('show'); }, 2000);
        }

        // ==================== Dify 应用能力配置动态适配 ====================

        async function loadAppParameters() {
            try {
                const response = await fetch(`/api/chat/${appId}/parameters`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        appFeatures = data;
                        renderDynamicUI(data);
                    }
                }
            } catch (error) {
                console.error('加载应用配置失败:', error);
                // 降级：保持默认显示
            }
        }

        function renderDynamicUI(config) {
            const features = config.features || {};
            const ui = config.ui || {};
            const inputs = config.inputs || {};

            // 1. 文件上传按钮和拖拽区域
            const fuConfig = features.file_upload || {};
            if (uploadBtn) {
                uploadBtn.style.display = fuConfig.enabled ? '' : 'none';
            }
            if (fileInput) {
                fileInput.style.display = 'none'; // 始终隐藏，通过 uploadBtn 触发
            }
            // 如果没有文件上传，禁用拖拽
            if (!fuConfig.enabled && dropZone) {
                dropZone.classList.add('upload-disabled');
            }
            setupFileUploadRestrictions(fuConfig);

            // 2. 语音按钮
            if (voiceBtn) {
                voiceBtn.style.display = features.speech_to_text ? '' : 'none';
            }

            // 3. 动态输入表单（替代硬编码的 modeSelector）
            renderInputForms(inputs.user_input_form || []);

            // 4. 开场白
            if (ui.opening_statement) {
                const h3 = welcomeMessage.querySelector('h3');
                if (h3) h3.textContent = ui.opening_statement;
            }

            // 5. 建议问题
            if (ui.suggested_questions && ui.suggested_questions.length > 0) {
                renderSuggestedQuestions(ui.suggested_questions);
            }
        }

        function setupFileUploadRestrictions(config) {
            if (!config || !config.enabled) return;

            // 设置 accept 属性
            if (fileInput && config.allowed_extensions && config.allowed_extensions.length > 0) {
                const acceptStr = config.allowed_extensions.join(',').toLowerCase();
                fileInput.setAttribute('accept', acceptStr);
            }

            // 设置 multiple 属性
            if (fileInput && config.max_files && config.max_files > 1) {
                fileInput.setAttribute('multiple', '');
            } else if (fileInput) {
                fileInput.removeAttribute('multiple');
            }

            // 添加提示文字
            let hint = document.getElementById('uploadHint');
            if (!hint) {
                hint = document.createElement('div');
                hint.id = 'uploadHint';
                hint.className = 'upload-hint';
                hint.style.cssText = 'font-size: 11px; color: var(--text-muted); margin-top: 4px; padding-left: 4px;';
                const inputLeft = document.querySelector('.input-left');
                if (inputLeft) inputLeft.appendChild(hint);
            }
            const exts = (config.allowed_extensions || []).map(e => e.replace('.', '').toUpperCase()).join('/');
            const typeText = exts || (config.allowed_types || []).join('/');
            hint.textContent = `最多 ${config.max_files || 1} 个，单个 ≤ ${config.max_size_mb || 15}MB${typeText ? '，支持 ' + typeText : ''}`;
            hint.style.display = '';
        }

        function renderInputForms(forms) {
            const container = document.querySelector('.input-options');
            if (!forms || forms.length === 0) {
                if (container) container.style.display = 'none';
                return;
            }

            let html = '<div class="dynamic-inputs">';
            for (const field of forms) {
                const type = field.type;
                const varName = field.variable;
                const label = field.label;
                const defVal = field.default || '';
                const placeholder = field.placeholder || label;

                if (type === 'select') {
                    html += `<select class="dynamic-input" data-variable="${escapeHtml(varName)}" title="${escapeHtml(label)}">`;
                    for (const opt of (field.options || [])) {
                        const selected = opt === defVal ? 'selected' : '';
                        html += `<option value="${escapeHtml(opt)}" ${selected}>${escapeHtml(opt)}</option>`;
                    }
                    html += `</select>`;
                } else if (type === 'text') {
                    html += `<input type="text" class="dynamic-input" data-variable="${escapeHtml(varName)}" placeholder="${escapeHtml(placeholder)}" value="${escapeHtml(defVal)}">`;
                } else if (type === 'paragraph') {
                    html += `<textarea class="dynamic-input" data-variable="${escapeHtml(varName)}" placeholder="${escapeHtml(placeholder)}">${escapeHtml(defVal)}</textarea>`;
                } else if (type === 'number') {
                    html += `<input type="number" class="dynamic-input" data-variable="${escapeHtml(varName)}" placeholder="${escapeHtml(placeholder)}" value="${escapeHtml(defVal)}">`;
                } else {
                    console.warn(`暂不支持的表单类型: ${type}`);
                }
            }
            html += '</div>';
            if (container) {
                container.innerHTML = html;
                container.style.display = '';
            }
        }

        function renderSuggestedQuestions(questions) {
            const welcome = document.getElementById('welcomeMessage');
            if (!welcome) return;

            let container = document.getElementById('suggestedQuestions');
            if (!container) {
                container = document.createElement('div');
                container.id = 'suggestedQuestions';
                container.className = 'suggested-questions';
                container.style.cssText = 'display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 16px;';
                welcome.appendChild(container);
            }

            container.innerHTML = questions.map(q => {
                const safeQ = escapeHtml(q);
                return `<button class="suggested-btn" onclick="sendSuggestedQuestion('${safeQ.replace(/'/g, "\\'")}')">${safeQ}</button>`;
            }).join('');
        }

        function sendSuggestedQuestion(text) {
            messageInput.value = text;
            sendMessage();
        }

        function collectInputs() {
            const inputs = {};
            document.querySelectorAll('.dynamic-input').forEach(el => {
                inputs[el.dataset.variable] = el.value;
            });
            return inputs;
        }

        function isImageFile(file) {
            if (!file || !file.type) return false;
            return file.type.startsWith('image/');
        }

        async function loadUserApps() {
            try {
                const response = await fetch('/api/user/apps');
                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        userApps = data.apps || [];
                        renderAppSelector();
                        renderPortalApps();
                    }
                }
            } catch (error) { console.error('加载应用列表失败:', error); }
        }

        function renderAppSelector() {
            if (!appSelector) return;
            appSelector.innerHTML = '';
            userApps.forEach(app => {
                const option = document.createElement('option');
                option.value = app.id;
                option.textContent = app.name;
                if (app.id === appId) option.selected = true;
                appSelector.appendChild(option);
            });
        }

        function renderPortalApps() {
            const container = document.getElementById('portalAppsList');
            if (!container) return;
            container.innerHTML = '';
            userApps.forEach(app => {
                const item = document.createElement('div');
                item.className = 'portal-app-item' + (app.id === appId ? ' active' : '');
                item.title = app.name;
                item.onclick = () => switchApp(app.id);
                const logoHtml = app.logo_url
                    ? `<img src="${escapeHtml(app.logo_url)}" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:8px;">`
                    : app.name.charAt(0);
                item.innerHTML = `
                    <div class="portal-app-icon">${logoHtml}</div>
                    <span class="portal-app-name">${escapeHtml(app.name)}</span>
                `;
                container.appendChild(item);
            });
        }

        async function switchApp(newAppId) {
            newAppId = parseInt(newAppId);
            if (newAppId === appId) return;

            try {
                const response = await fetch(`/api/apps/${newAppId}`);
                if (!response.ok) {
                    showToast('切换应用失败');
                    return;
                }
                const data = await response.json();
                if (!data.success) {
                    showToast('切换应用失败');
                    return;
                }

                const app = data.app;
                appId = app.id;
                userField = app.user_field || 'name';
                currentApp = {
                    id: app.id,
                    name: app.name,
                    welcome_message: app.welcome_message || '你好！有什么可以帮助你的吗？',
                    description: app.description || '',
                    logo_url: app.logo_url || ''
                };

                // 更新 URL（不刷新页面）
                history.pushState({ appId: appId }, '', `/chat/${appId}`);
                document.title = `${app.name} - Dify Portal`;

                // 更新 header 中的应用标题
                const appTitle = document.querySelector('.app-title');
                if (appTitle) appTitle.textContent = app.name;

                // 更新应用选择器选中项
                renderAppSelector();

                // 重置聊天状态
                currentConversationId = null;
                conversations = [];
                chatContainer.innerHTML = '';

                // 重新创建欢迎消息（含应用介绍）
                const descHtml = currentApp.description ? `<div class="app-description">${escapeHtml(currentApp.description)}</div>` : '';
                const logoHtml = currentApp.logo_url
                    ? `<img src="${escapeHtml(currentApp.logo_url)}" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:var(--radius-lg);">`
                    : '🤖';
                const newWelcome = document.createElement('div');
                newWelcome.className = 'welcome-message';
                newWelcome.id = 'welcomeMessage';
                newWelcome.innerHTML = `
                    <div class="welcome-icon">${logoHtml}</div>
                    <h3>${currentApp.welcome_message || '你好！有什么可以帮助你的吗？'}</h3>
                    <p>开始对话吧</p>
                    ${descHtml}
                `;
                chatContainer.appendChild(newWelcome);
                welcomeMessage = newWelcome;

                // 重新加载应用参数和历史对话
                await loadAppParameters();
                await loadConversations();

                // 更新 Portal 侧边栏激活状态
                renderPortalApps();

            } catch (error) {
                console.error('切换应用失败:', error);
                showToast('切换应用失败');
            }
        }

        async function loadConversations() {
            try {
                const response = await fetch(`/api/chat/${appId}/conversations`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        conversations = data.conversations || [];
                        renderConversationList();
                    } else conversationList.innerHTML = '<div class="empty-conversations">暂无历史对话</div>';
                } else conversationList.innerHTML = '<div class="empty-conversations">加载失败</div>';
            } catch (error) {
                console.error('加载会话列表失败:', error);
                conversationList.innerHTML = '<div class="empty-conversations">加载失败</div>';
            }
        }

        function renderConversationList() {
            if (conversations.length === 0) {
                conversationList.innerHTML = '<div class="empty-conversations">暂无历史对话</div>';
                return;
            }
            conversationList.innerHTML = '';
            conversations.forEach(conv => {
                const item = document.createElement('div');
                item.className = 'conversation-item' + (conv.id === currentConversationId ? ' active' : '');
                item.onclick = () => {
                    loadConversation(conv.id);
                    if (window.innerWidth <= 768) toggleSidebar();
                };
                const title = conv.name || '未命名对话';
                const time = new Date(conv.created_at * 1000).toLocaleDateString('zh-CN');
                item.innerHTML = `<div class="conv-title">${escapeHtml(title)}</div><div class="conv-time">${time}</div>`;
                conversationList.appendChild(item);
            });
        }

        async function loadConversation(conversationId) {
            currentConversationId = conversationId;
            renderConversationList();
            welcomeMessage.style.display = 'none';
            chatContainer.innerHTML = '';
            try {
                const response = await fetch(`/api/chat/${appId}/messages?conversation_id=${conversationId}`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.success && data.messages && data.messages.length > 0) {
                        const messages = data.messages.reverse();
                        messages.forEach(msg => {
                            if (msg.query) addMessage(msg.query, true, msg.files);
                            if (msg.answer) addMessage(msg.answer, false, null, msg.id);
                        });
                    }
                }
            } catch (error) { console.error('加载消息失败:', error); }
        }

        function startNewChat() {
            currentConversationId = null;
            chatContainer.innerHTML = '';
            const descHtml = currentApp.description ? `<div class="app-description">${escapeHtml(currentApp.description)}</div>` : '';
            const logoHtml = currentApp.logo_url
                ? `<img src="${escapeHtml(currentApp.logo_url)}" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:var(--radius-lg);">`
                : '🤖';
            const newWelcome = document.createElement('div');
            newWelcome.className = 'welcome-message';
            newWelcome.id = 'welcomeMessage';
            newWelcome.innerHTML = `
                <div class="welcome-icon">${logoHtml}</div>
                <h3>${currentApp.welcome_message || '你好！有什么可以帮助你的吗？'}</h3>
                <p>开始对话吧</p>
                ${descHtml}
            `;
            chatContainer.appendChild(newWelcome);
            welcomeMessage = newWelcome;
            renderConversationList();
            if (window.innerWidth <= 768) toggleSidebar();
        }

        messageInput.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 150) + 'px';
        });

        messageInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                if (e.ctrlKey) {
                    e.preventDefault();
                    const start = this.selectionStart;
                    const end = this.selectionEnd;
                    const value = this.value;
                    this.value = value.substring(0, start) + '\n' + value.substring(end);
                    this.selectionStart = this.selectionEnd = start + 1;
                    this.style.height = 'auto';
                    this.style.height = Math.min(this.scrollHeight, 150) + 'px';
                    return;
                }
                e.preventDefault();
                sendMessage();
            }
        });

        function handleFileSelect(event) {
            const files = Array.from(event.target.files);
            if (!files.length) return;

            const fuConfig = appFeatures?.features?.file_upload;
            if (!fuConfig || !fuConfig.enabled) {
                showToast('❌ 该应用未开启文件上传功能');
                event.target.value = '';
                return;
            }

            // 1. 数量校验
            const maxFiles = fuConfig.max_files || 1;
            if (pendingFiles.length + files.length > maxFiles) {
                showToast(`❌ 最多只能上传 ${maxFiles} 个文件`);
                event.target.value = '';
                return;
            }

            // 2. 大小校验
            for (const file of files) {
                const sizeLimit = isImageFile(file)
                    ? (fuConfig.max_image_size_mb || fuConfig.max_size_mb || 15)
                    : (fuConfig.max_size_mb || 15);
                if (file.size > sizeLimit * 1024 * 1024) {
                    showToast(`❌ 文件 ${escapeHtml(file.name)} 超过 ${sizeLimit}MB 限制`);
                    event.target.value = '';
                    return;
                }
            }

            // 3. 扩展名校验
            const allowedExts = fuConfig.allowed_extensions || [];
            if (allowedExts.length > 0) {
                for (const file of files) {
                    const ext = '.' + file.name.split('.').pop().toUpperCase();
                    if (!allowedExts.includes(ext)) {
                        showToast(`❌ 不支持的文件格式: ${ext}`);
                        event.target.value = '';
                        return;
                    }
                }
            }

            pendingFiles.push(...files);
            renderFilePreview();
            event.target.value = '';
        }

        function renderFilePreview() {
            if (pendingFiles.length === 0) {
                filePreview.classList.remove('active');
                filePreview.innerHTML = '';
                return;
            }
            filePreview.classList.add('active');
            filePreview.innerHTML = '';
            pendingFiles.forEach((file, index) => {
                const item = document.createElement('div');
                item.className = 'file-preview-item';
                if (isImageFile(file)) {
                    const img = document.createElement('img');
                    img.src = URL.createObjectURL(file);
                    img.onload = () => URL.revokeObjectURL(img.src);
                    item.appendChild(img);
                } else item.innerHTML = `<span>📄 ${escapeHtml(file.name)}</span>`;
                const removeBtn = document.createElement('button');
                removeBtn.className = 'remove-btn';
                removeBtn.innerHTML = '×';
                removeBtn.onclick = () => {
                    pendingFiles.splice(index, 1);
                    renderFilePreview();
                };
                item.appendChild(removeBtn);
                filePreview.appendChild(item);
            });
        }

        async function uploadFiles() {
            if (pendingFiles.length === 0) return [];
            const uploadedFiles = [];
            for (let file of pendingFiles) {
                const formData = new FormData();
                formData.append('file', file);
                try {
                    const response = await fetch(`/api/chat/${appId}/upload`, {
                        method: 'POST',
                        body: formData
                    });
                    if (response.ok) {
                        const data = await response.json();
                        if (data.success && data.file) uploadedFiles.push(data.file);
                    }
                } catch (error) { console.error('文件上传失败:', error); }
            }
            return uploadedFiles;
        }

        async function toggleVoiceInput() {
            if (isRecording) stopRecording();
            else startRecording();
        }

        async function startRecording() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];
                mediaRecorder.ondataavailable = (event) => { if (event.data.size > 0) audioChunks.push(event.data); };
                mediaRecorder.onstop = async () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
                    await uploadVoiceFile(audioBlob);
                    stream.getTracks().forEach(track => track.stop());
                };
                mediaRecorder.start();
                isRecording = true;
                voiceBtn.classList.add('recording');
                showToast('🎤 录音中...点击停止');
            } catch (error) {
                console.error('无法访问麦克风:', error);
                showToast('❌ 无法访问麦克风');
            }
        }

        function stopRecording() {
            if (mediaRecorder && isRecording) {
                mediaRecorder.stop();
                isRecording = false;
                voiceBtn.classList.remove('recording');
                showToast('✅ 录音完成，正在识别...');
            }
        }

        async function uploadVoiceFile(audioBlob) {
            const formData = new FormData();
            formData.append('file', audioBlob, 'recording.wav');
            try {
                const response = await fetch(`/api/chat/${appId}/speech-to-text`, {
                    method: 'POST',
                    body: formData
                });
                const data = await response.json();
                if (data.success && data.text) {
                    messageInput.value = data.text;
                    messageInput.style.height = 'auto';
                    messageInput.style.height = Math.min(messageInput.scrollHeight, 120) + 'px';
                    showToast('✅ 语音识别完成');
                } else showToast('❌ 语音识别失败: ' + (data.error || data.detail || '未知错误'));
            } catch (error) {
                console.error('语音识别失败:', error);
                showToast('❌ 语音识别失败');
            }
        }

        function setupDragDrop() {
            const dropZone = document.getElementById('dropZone');
            if (!dropZone) return;
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, preventDefaults, false);
                document.body.addEventListener(eventName, preventDefaults, false);
            });
            function preventDefaults(e) {
                e.preventDefault();
                e.stopPropagation();
            }
            dropZone.addEventListener('dragenter', (e) => {
                if (appFeatures?.features?.file_upload?.enabled) dropZone.classList.add('drag-over');
            });
            dropZone.addEventListener('dragover', (e) => {
                if (appFeatures?.features?.file_upload?.enabled) dropZone.classList.add('drag-over');
            });
            dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
            dropZone.addEventListener('drop', (e) => {
                dropZone.classList.remove('drag-over');

                // 检查文件上传是否启用
                const fuConfig = appFeatures?.features?.file_upload;
                if (!fuConfig || !fuConfig.enabled) {
                    showToast('❌ 该应用未开启文件上传功能');
                    return;
                }

                const files = Array.from(e.dataTransfer.files);
                if (!files.length) return;

                // 数量校验
                const maxFiles = fuConfig.max_files || 1;
                if (pendingFiles.length + files.length > maxFiles) {
                    showToast(`❌ 最多只能上传 ${maxFiles} 个文件`);
                    return;
                }

                // 大小校验
                for (const file of files) {
                    const sizeLimit = isImageFile(file)
                        ? (fuConfig.max_image_size_mb || fuConfig.max_size_mb || 15)
                        : (fuConfig.max_size_mb || 15);
                    if (file.size > sizeLimit * 1024 * 1024) {
                        showToast(`❌ 文件 ${escapeHtml(file.name)} 超过 ${sizeLimit}MB 限制`);
                        return;
                    }
                }

                // 扩展名校验
                const allowedExts = fuConfig.allowed_extensions || [];
                if (allowedExts.length > 0) {
                    for (const file of files) {
                        const ext = '.' + file.name.split('.').pop().toUpperCase();
                        if (!allowedExts.includes(ext)) {
                            showToast(`❌ 不支持的文件格式: ${ext}`);
                            return;
                        }
                    }
                }

                pendingFiles.push(...files);
                renderFilePreview();
                showToast(`✅ 已添加 ${files.length} 个文件`);
            });
        }

        async function sendMessage() {
            const message = messageInput.value.trim();
            if (!message && pendingFiles.length === 0) return;
            let uploadedFiles = [];
            if (pendingFiles.length > 0) {
                sendBtn.disabled = true;
                sendBtn.innerHTML = '<span>🔄</span><span>上传中...</span>';
                uploadedFiles = await uploadFiles();
                pendingFiles = [];
                renderFilePreview();
                sendBtn.disabled = false;
                sendBtn.innerHTML = '<span>🚰</span><span>发送</span>';
            }
            addMessage(message || (uploadedFiles.length > 0 ? '[文件]' : ''), true, uploadedFiles);
            messageInput.value = '';
            messageInput.style.height = 'auto';
            welcomeMessage.style.display = 'none';
            showTypingIndicator();
            // 立即创建 AI 占位消息，让用户知道系统正在响应
            const placeholderId = 'placeholder-' + Date.now();
            createPlaceholderMessage(placeholderId, '思考中...');
            sendBtn.style.display = 'none';
            stopBtn.style.display = 'flex';
            abortController = new AbortController();
            const payload = {
                message: message,
                conversation_id: currentConversationId,
                inputs: collectInputs(),
                files: uploadedFiles.length > 0 ? uploadedFiles.map(f => ({ type: f.type.startsWith('image/') ? 'image' : 'document', transfer_method: 'local_file', upload_file_id: f.id })) : undefined
            };
            try {
                const response = await fetch(`/api/chat/${appId}/stream`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                    signal: abortController.signal
                });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';
                let messageContent = '';
                let thinkingContent = '';  // 思考过程缓冲区
                let currentMessageId = null;
                removeTypingIndicator();
                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    buffer += decoder.decode(value, { stream: true });
                    const lines = buffer.split('\n');
                    buffer = lines.pop();
                    for (const line of lines) {
                        if (!line.trim()) continue;
                        try {
                            const event = JSON.parse(line);
                            if (event.event === 'message' || event.event === 'agent_message' || event.event === 'workflow') {
                                // 移除占位消息，开始正式流式显示
                                removePlaceholderMessage(placeholderId);
                                if (!currentMessageId) {
                                    currentMessageId = event.message_id;
                                    createStreamingMessage(currentMessageId);
                                }
                                const answer = event.answer || '';
                                // 所有内容先流入主内容，最终渲染时再解析 thinking 标签
                                messageContent += answer;
                                updateStreamingMessage(currentMessageId, messageContent, thinkingContent);
                                if (event.conversation_id) currentConversationId = event.conversation_id;
                            } else if (event.event === 'message_end' || event.event === 'workflow_finished') {
                                // 最终渲染时解析 thinking 标签（仅在非 show 模式下）
                                if (THINKING_DISPLAY_MODE !== 'show') {
                                    const parsed = parseThinkingContent(messageContent);
                                    messageContent = parsed.mainContent;
                                    thinkingContent = parsed.thinkingContent;
                                }
                                finalizeStreamingMessage(currentMessageId, messageContent, thinkingContent, event.message_id || currentMessageId);
                                // 立即将新对话添加到本地列表，确保刷新前能看到
                                if (currentConversationId && !conversations.find(c => c.id === currentConversationId)) {
                                    conversations.unshift({
                                        id: currentConversationId,
                                        name: (message || '新对话').slice(0, 50) + ((message || '').length > 50 ? '...' : ''),
                                        created_at: Math.floor(Date.now() / 1000)
                                    });
                                    renderConversationList();
                                }
                            } else if (event.event === 'error') throw new Error(event.message || 'Stream error');
                        } catch (e) { console.error('解析流数据错误:', e, line); }
                    }
                }
            } catch (error) {
                removePlaceholderMessage(placeholderId);
                if (error.name === 'AbortError') {
                    removeTypingIndicator();
                    addMessage('[用户取消生成]', false);
                } else {
                    console.error('发送消息失败:', error);
                    removeTypingIndicator();
                    addMessage('抱歉，发送消息失败：' + error.message, false);
                }
            } finally {
                sendBtn.style.display = 'flex';
                stopBtn.style.display = 'none';
                abortController = null;
            }
        }

        function stopGeneration() {
            if (abortController) {
                abortController.abort();
                showToast('已停止生成');
            }
        }

        function addMessage(content, isUser = false, files = null, messageId = null) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${isUser ? 'message-user' : 'message-assistant'}`;
            if (messageId) messageDiv.id = `msg-${messageId}`;
            let html = '';
            if (files && files.length > 0) {
                html += '<div class="message-files">';
                files.forEach(file => {
                    if (file.type && file.type.startsWith('image/')) html += `<div class="message-file"><img src="${escapeHtml(file.url || '#')}" alt="${escapeHtml(file.name)}"></div>`;
                    else html += `<div class="message-file">📄 ${escapeHtml(file.name || '文件')}</div>`;
                });
                html += '</div>';
            }
            if (content) {
                if (isUser) {
                    html += `<div>${escapeHtml(content)}</div>`;
                } else {
                    // 非流式消息解析 thinking 标签（仅在非 show 模式下）
                    if (THINKING_DISPLAY_MODE !== 'show') {
                        const parsed = parseThinkingContent(content);
                        let msgHtml = '';
                        if (parsed.thinkingContent) {
                            msgHtml += `<details class="thinking-panel"><summary>🤔 思考过程</summary><div class="thinking-body">${marked.parse(parsed.thinkingContent)}</div></details>`;
                        }
                        if (parsed.mainContent) {
                            msgHtml += `<div class="markdown-body">${marked.parse(parsed.mainContent)}</div>`;
                        }
                        html += msgHtml;
                    } else {
                        html += `<div class="markdown-body">${marked.parse(content)}</div>`;
                    }
                }
            }
            if (!isUser && messageId) {
                html += `<div class="message-actions">
                    <button class="message-action-btn" onclick="likeMessage('${messageId}')" id="like-${messageId}">👍 有用</button>
                    <button class="message-action-btn" onclick="dislikeMessage('${messageId}')" id="dislike-${messageId}">👎 无用</button>
                    <button class="message-action-btn" onclick="copyMessage('${messageId}')">📋 复制</button>
                </div>`;
            }
            const time = new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
            html += `<div class="message-time">${time}</div>`;
            messageDiv.innerHTML = html;
            chatContainer.appendChild(messageDiv);
            scrollToBottom();
            if (!isUser) highlightCode(messageDiv);
        }

        /**
         * 解析内容中的 thinking 标签，分离主内容和思考过程
         * 支持的标签格式: <thinking>...</thinking>, <think>...</think>, <details>...</details>
         */
        function parseThinkingContent(content) {
            if (!content) return { mainContent: '', thinkingContent: '' };

            let thinkingContent = '';
            let mainContent = content;

            // 匹配 <thinking> 或 <think> 标签
            const thinkRegex = /<(thinking|think)(?:\s[^>]*)?>([\s\S]*?)<\/\1>/gi;
            let match;
            while ((match = thinkRegex.exec(content)) !== null) {
                thinkingContent += match[2].trim() + '\n\n';
            }
            mainContent = mainContent.replace(/<(thinking|think)(?:\s[^>]*)?>([\s\S]*?)<\/\1>/gi, '');

            // 匹配 <details> 标签（常用于 reasoning 内容）
            const detailsRegex = /<details(?:\s[^>]*)?>([\s\S]*?)<\/details>/gi;
            while ((match = detailsRegex.exec(content)) !== null) {
                thinkingContent += match[1].trim() + '\n\n';
            }
            mainContent = mainContent.replace(/<details(?:\s[^>]*)?>([\s\S]*?)<\/details>/gi, '');

            // 清理多余的空行
            mainContent = mainContent.replace(/\n{3,}/g, '\n\n').trim();
            thinkingContent = thinkingContent.trim();

            return { mainContent, thinkingContent };
        }

        function createStreamingMessage(messageId) {
            currentStreamingMessage = document.createElement('div');
            currentStreamingMessage.className = 'message message-assistant';
            currentStreamingMessage.id = `msg-${messageId}`;
            currentStreamingMessage.innerHTML = `
                <div class="markdown-body"><span class="streaming-content"></span><span class="streaming-cursor"></span></div>
                <div class="thinking-area" style="display:none;"><details class="thinking-panel"><summary>🤔 思考过程</summary><div class="thinking-body"></div></details></div>
            `;
            chatContainer.appendChild(currentStreamingMessage);
            scrollToBottom();
        }

        function updateStreamingMessage(messageId, content, thinking) {
            if (currentStreamingMessage && currentStreamingMessage.id === `msg-${messageId}`) {
                const contentSpan = currentStreamingMessage.querySelector('.streaming-content');
                if (contentSpan) contentSpan.innerHTML = marked.parse(content);
                // 更新思考过程面板
                if (THINKING_DISPLAY_MODE !== 'show' && thinking && thinking.trim()) {
                    const thinkingArea = currentStreamingMessage.querySelector('.thinking-area');
                    const thinkingBody = currentStreamingMessage.querySelector('.thinking-body');
                    if (thinkingArea && thinkingBody) {
                        thinkingBody.innerHTML = marked.parse(thinking);
                        thinkingArea.style.display = THINKING_DISPLAY_MODE === 'hidden' ? 'none' : '';
                    }
                }
                scrollToBottom();
            }
        }

        function finalizeStreamingMessage(messageId, content, thinking, finalId) {
            if (currentStreamingMessage && currentStreamingMessage.id === `msg-${messageId}`) {
                const time = new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
                let thinkingHtml = '';
                if (THINKING_DISPLAY_MODE !== 'show' && thinking && thinking.trim()) {
                    if (THINKING_DISPLAY_MODE === 'fold') {
                        thinkingHtml = `<div class="thinking-area"><details class="thinking-panel"><summary>🤔 思考过程</summary><div class="thinking-body">${marked.parse(thinking)}</div></details></div>`;
                    }
                    // hidden 模式不渲染 thinkingHtml
                }
                currentStreamingMessage.innerHTML = `<div class="markdown-body">${marked.parse(content)}</div>
                    ${thinkingHtml}
                    <div class="message-actions">
                        <button class="message-action-btn" onclick="likeMessage('${finalId}')" id="like-${finalId}">👍 有用</button>
                        <button class="message-action-btn" onclick="dislikeMessage('${finalId}')" id="dislike-${finalId}">👎 无用</button>
                        <button class="message-action-btn" onclick="copyMessage('${finalId}')">📋 复制</button>
                    </div>
                    <div class="message-time">${time}</div>`;
                currentStreamingMessage.id = `msg-${finalId}`;
                highlightCode(currentStreamingMessage);
                currentStreamingMessage = null;
            }
        }


        function createPlaceholderMessage(id, text) {
            const existing = document.getElementById(id);
            if (existing) existing.remove();
            const div = document.createElement('div');
            div.id = id;
            div.className = 'message message-assistant';
            div.innerHTML = `<div class="markdown-body"><p style="color: var(--text-muted);">${text} <span class="streaming-cursor"></span></p></div>`;
            chatContainer.appendChild(div);
            scrollToBottom();
        }

        function removePlaceholderMessage(id) {
            const div = document.getElementById(id);
            if (div) div.remove();
        }

        function showTypingIndicator() {
            const existing = document.getElementById('typing-indicator');
            if (existing) existing.remove();
            const typingDiv = document.createElement('div');
            typingDiv.id = 'typing-indicator';
            typingDiv.className = 'typing-indicator';
            typingDiv.innerHTML = '<div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>';
            chatContainer.appendChild(typingDiv);
            scrollToBottom();
        }

        function removeTypingIndicator() {
            const typingDiv = document.getElementById('typing-indicator');
            if (typingDiv) typingDiv.remove();
        }

        function scrollToBottom() {
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        function highlightCode(element) {
            element.querySelectorAll('pre code').forEach(block => {
                hljs.highlightElement(block);
                const copyBtn = document.createElement('button');
                copyBtn.className = 'copy-code-btn';
                copyBtn.textContent = '复制';
                copyBtn.onclick = () => {
                    navigator.clipboard.writeText(block.textContent);
                    copyBtn.textContent = '已复制!';
                    setTimeout(() => copyBtn.textContent = '复制', 2000);
                };
                block.parentElement.appendChild(copyBtn);
            });
        }

        async function likeMessage(messageId) {
            try {
                const response = await fetch(`/api/chat/${appId}/feedback`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message_id: messageId, rating: 'like' })
                });
                if (response.ok) {
                    const btn = document.getElementById(`like-${messageId}`);
                    const dislikeBtn = document.getElementById(`dislike-${messageId}`);
                    if (btn) btn.classList.add('active-like');
                    if (dislikeBtn) dislikeBtn.classList.remove('active-dislike');
                    showToast('✅ 感谢您的反馈！');
                }
            } catch (error) { console.error('点赞失败:', error); }
        }

        let pendingDislikeMessageId = null;

        function openFeedbackModal(messageId) {
            pendingDislikeMessageId = messageId;
            document.getElementById('feedbackContent').value = '';
            document.getElementById('feedbackModal').classList.add('show');
        }

        function closeFeedbackModal() {
            document.getElementById('feedbackModal').classList.remove('show');
            pendingDislikeMessageId = null;
        }

        async function submitFeedback() {
            if (!pendingDislikeMessageId) return;
            const content = document.getElementById('feedbackContent').value.trim();
            closeFeedbackModal();
            try {
                const response = await fetch(`/api/chat/${appId}/feedback`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message_id: pendingDislikeMessageId, rating: 'dislike', content: content || null })
                });
                if (response.ok) {
                    const btn = document.getElementById(`dislike-${pendingDislikeMessageId}`);
                    const likeBtn = document.getElementById(`like-${pendingDislikeMessageId}`);
                    if (btn) btn.classList.add('active-dislike');
                    if (likeBtn) likeBtn.classList.remove('active-like');
                    showToast('✅ 感谢您的反馈！');
                }
            } catch (error) { console.error('点踩失败:', error); }
            pendingDislikeMessageId = null;
        }

        // 点击遮罩层也可以关闭弹窗
        document.getElementById('feedbackModal').addEventListener('click', function(e) {
            if (e.target === this) closeFeedbackModal();
        });

        // 按 Enter 提交（不按 shift）
        document.getElementById('feedbackContent').addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                submitFeedback();
            }
        });

        async function dislikeMessage(messageId) {
            openFeedbackModal(messageId);
        }

        function copyMessage(messageId) {
            const msgDiv = document.getElementById(`msg-${messageId}`);
            if (msgDiv) {
                const content = msgDiv.querySelector('.markdown-body');
                if (content) {
                    navigator.clipboard.writeText(content.textContent);
                    showToast('✅ 已复制到剪贴板');
                }
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
    <!-- 点踩反馈弹窗 -->
    <div class="feedback-modal-overlay" id="feedbackModal">
        <div class="feedback-modal">
            <h3>👎 告诉我们哪里不好</h3>
            <p>您的反馈将帮助我们改进服务质量</p>
            <textarea id="feedbackContent" placeholder="请描述您不满意的原因（可选）..."></textarea>
            <div class="feedback-modal-buttons">
                <button class="feedback-modal-btn cancel" onclick="closeFeedbackModal()">取消</button>
                <button class="feedback-modal-btn submit" onclick="submitFeedback()">提交反馈</button>
            </div>
        </div>
    </div>

    <!-- Change Password Modal -->
    <div class="modal" id="passwordModal">
        <div class="modal-content" style="max-width: 420px;">
            <div class="modal-header">
                <h3>🔒 修改密码</h3>
                <button class="modal-close" onclick="hidePasswordModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>当前密码</label>
                    <input type="password" id="oldPassword" placeholder="请输入当前密码">
                </div>
                <div class="form-group">
                    <label>新密码</label>
                    <input type="password" id="newPassword" placeholder="请输入新密码">
                </div>
                <div class="form-group">
                    <label>确认新密码</label>
                    <input type="password" id="confirmPassword" placeholder="请再次输入新密码">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="hidePasswordModal()">取消</button>
                <button type="button" class="btn btn-primary" onclick="submitChangePassword()">确认修改</button>
            </div>
        </div>
    </div>

</body>
</html>
